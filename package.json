    "test:client": "node scripts/run-tests.mjs --layer=client",
    "test:tooling": "node scripts/run-tests.mjs --layer=tooling",
    "test:s1:browser": "node scripts/s1-browser-check.mjs",
    "test:s2:browser": "node scripts/s2-browser-check.mjs",
    "test:s3": "node scripts/s3/run.mjs",
    "test:s3:encoding": "node scripts/s3/run.mjs --case=S3-E1",
    "test:preview": "node scripts/s1-preview-check.mjs",
    "check": "node scripts/check.mjs",
    "test:browser": "node scripts/browser-check.mjs",
