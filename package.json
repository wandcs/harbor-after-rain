    "eslint": "10.14.0",
    "playwright-core": "^1.63.0",
    "prettier": "3.10.1"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "overrides": {
    "eslint": {
      "minimatch": "11.0.1"
    }
  }
