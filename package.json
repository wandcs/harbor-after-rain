    "compare:hands": "node scripts/hand-compare.mjs --phase after",
    "report:hands": "node scripts/hand-review.mjs",
    "compare:arms": "node scripts/arm-compare.mjs --phase after",
    "report:arms": "node scripts/arm-review.mjs",
    "test:mobile": "node scripts/mobile-controls-check.mjs",
